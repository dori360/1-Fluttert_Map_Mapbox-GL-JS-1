rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_locations/{userId} {
      allow read: if true;  // Anyone can read all user locations
      allow write: if request.auth != null && request.auth.uid == userId;  // Only authenticated users can write their own location
    }
    
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}